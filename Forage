-- Lua LEM script to automate forage V1.0
local mq = require('mq')

-- Check if LEM is actually the one loading this
if not package.loaded['events'] then
    print('\ar[Forage]\ax This script is intended for Lua Event Manager (LEM). Try "\a-t/lua run lem\a-x"')
end

local function on_load()
    print('\ag[Forage]\ax LEM Module Loaded. Monitoring windows for safety.')
end

---@return boolean @Returns true if we are ready to forage
local function condition()
    -- 1. Basic State Checks
    if (mq.TLO.Me.Skill('Forage')() or 0) <= 0 then return false end
    if not mq.TLO.Me.Standing() or mq.TLO.Me.Combat() or mq.TLO.Me.Casting() then return false end
    if (mq.TLO.Me.FreeInventory() or 0) < 5 then return false end

    -- 2. Safety Windows Check (Pause if any of these are open)
    -- Added: Inventory, Merchant, Bank, Spellbook, and Trade
    if mq.TLO.Window('InventoryWindow').Open() or 
       mq.TLO.Window('MerchantWnd').Open() or 
       mq.TLO.Window('BigBankWnd').Open() or 
       mq.TLO.Window('SpellBookWnd').Open() or 
       mq.TLO.Window('TradeWnd').Open() then 
        return false 
    end

    -- 3. Logic: Trigger only if Forage is ready
    return mq.TLO.Me.AbilityReady('Forage')()
end

local function action()
    -- Priority: Use Forage
    if mq.TLO.Me.AbilityReady('Forage')() then
        mq.cmd('/doability Forage')
        mq.delay(100)
    end
end

return { onload = on_load, condfunc = condition, actionfunc = action }
